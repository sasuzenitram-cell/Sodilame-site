{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(admin|espace)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/qr(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/accueil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nos-services",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/conseils",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/conseils/:slug",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/depannage",
      "destination": "/services/depannage-sav-cuisine-professionnelle",
      "permanent": true
    },
    {
      "source": "/froid",
      "destination": "/services/froid-professionnel",
      "permanent": true
    },
    {
      "source": "/entretien",
      "destination": "/services/contrat-entretien-cuisine-professionnelle",
      "permanent": true
    },
    {
      "source": "/services/laverie-buanderie-professionnelle",
      "destination": "/services/laverie-restauration",
      "permanent": true
    },
    {
      "source": "/laverie",
      "destination": "/services/laverie-restauration",
      "permanent": true
    },
    {
      "source": "/buanderie",
      "destination": "/services/buanderie-professionnelle",
      "permanent": true
    },
    {
      "source": "/mysodilame",
      "destination": "https://mysodilame.app",
      "permanent": false
    },
    {
      "source": "/eshop/blanchisserie-professionnelle",
      "destination": "/eshop/lave-linge-professionnels",
      "permanent": true
    },
    {
      "source": "/eshop/blanchisserie-professionnelle/miele-pwm-909-lave-linge-benchmark",
      "destination": "/eshop/lave-linge-professionnels/miele-pwm-909-lave-linge-benchmark",
      "permanent": true
    },
    {
      "source": "/eshop/blanchisserie-professionnelle/miele-pdr-910-seche-linge-benchmark",
      "destination": "/eshop/seche-linge-professionnels/miele-pdr-910-seche-linge-benchmark",
      "permanent": true
    },
    {
      "source": "/eshop/lave-vaisselle-professionnel/miele-ptd-701-lave-verres",
      "destination": "/eshop/lave-vaisselle-professionnel",
      "permanent": true
    },
    {
      "source": "/eshop/lave-vaisselle-professionnel/miele-ptd-901-lave-vaisselle-capot",
      "destination": "/eshop/lave-vaisselle-professionnel",
      "permanent": true
    },
    {
      "source": "/boutique",
      "destination": "/eshop",
      "permanent": true
    },
    {
      "source": "/boutique/:chemin*",
      "destination": "/eshop",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/eshop",
      "permanent": true
    },
    {
      "source": "/produits/ma-commande",
      "destination": "/eshop/panier",
      "permanent": true
    },
    {
      "source": "/produits",
      "has": [
        {
          "type": "query",
          "key": "famille",
          "value": "(?<famille>[a-z0-9-]+)"
        }
      ],
      "destination": "/eshop/:famille",
      "permanent": true
    },
    {
      "source": "/produits",
      "has": [
        {
          "type": "query",
          "key": "marque"
        }
      ],
      "destination": "/eshop/catalogue",
      "permanent": true
    },
    {
      "source": "/produits",
      "has": [
        {
          "type": "query",
          "key": "machine"
        }
      ],
      "destination": "/eshop/catalogue",
      "permanent": true
    },
    {
      "source": "/produits",
      "destination": "/eshop",
      "permanent": true
    },
    {
      "source": "/produits/:famille",
      "destination": "/eshop/:famille",
      "permanent": true
    },
    {
      "source": "/produits/:famille/:produit",
      "destination": "/eshop/:famille/:produit",
      "permanent": true
    },
    {
      "source": "/connexion",
      "destination": "/espace/connexion",
      "permanent": false
    },
    {
      "source": "/mon-compte",
      "destination": "/espace",
      "permanent": false
    },
    {
      "source": "/sav",
      "destination": "/qr/panne",
      "permanent": false
    },
    {
      "source": "/audit",
      "destination": "/qr/audit",
      "permanent": false
    },
    {
      "source": "/machine",
      "destination": "/qr",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/:section",
      "destination": "/api/admin?section=:section"
    },
    {
      "source": "/espace",
      "destination": "/api/espace"
    },
    {
      "source": "/espace/diagnostic",
      "destination": "/api/espace?vue=diagnostic"
    },
    {
      "source": "/espace/connexion",
      "destination": "/api/espace?vue=connexion"
    }
  ]
}
