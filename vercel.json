{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/accueil", "destination": "/", "permanent": true },
    { "source": "/nos-services", "destination": "/services", "permanent": true },
    { "source": "/blog", "destination": "/conseils", "permanent": true },
    { "source": "/blog/:slug", "destination": "/conseils/:slug", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/depannage", "destination": "/services/depannage-sav-cuisine-professionnelle", "permanent": true },
    { "source": "/froid", "destination": "/services/froid-professionnel", "permanent": true },
    { "source": "/entretien", "destination": "/services/contrat-entretien-cuisine-professionnelle", "permanent": true },
    { "source": "/mysodilame", "destination": "https://my.sodilame.com", "permanent": false },
    { "source": "/espace-client", "destination": "https://my.sodilame.com", "permanent": false }
  ]
}
